# Copiar este archivo y renombrar esa copia a cluster.env

# aws
AWS_REGION="us-east-1"
AWS_PROFILE="default"

# ssh
SSH_KEY="$HOME/.ssh/vockey.pem"
SSH_USER="ec2-user"

# Carpeta que se creará dentro del home remoto. Usar un solo nombre, sin espacios.
# El cliente de ingesta recibirá src/client_ingesta/ (carga y limpieza) y el de consulta, src/client_consulta/ (preguntas).
REMOTE_DIR="BigData-OpenFoodFacts"
